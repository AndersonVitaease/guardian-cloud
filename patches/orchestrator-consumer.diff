+def _trail_for_run_dir(run_dir):
+    """HEADLESS-TAB-02: caminho LITERAL da harness-trail.jsonl do run.
+    Padrão real (mission_run.py): <run_dir>/run-*/harness-trail.jsonl —
+    escolhe o mais recente. None se nada encontrado (fail-open)."""
+    if not run_dir:
+        return None
+    direct = os.path.join(run_dir, "harness-trail.jsonl")
+    if os.path.isfile(direct):
+        return direct
+    try:
+        cands = sorted(glob.glob(os.path.join(run_dir, "run-*", "harness-trail.jsonl")),
+                       key=os.path.getmtime)
+        return cands[-1] if cands else None
+    except Exception:
+        return None
+
