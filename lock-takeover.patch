+def _env_float(name: str, default: float) -> float:
+    try:
+        return float(os.environ.get(name, "") or default)
+    except (TypeError, ValueError):
+        return default
+
+
+LOCK_STEAL_MIN_SECONDS = _env_float("LOCK_STEAL_MIN", 120.0)
+LOCK_RETRY_MAX = max(0, int(_env_float("LOCK_RETRY_MAX", 3)))
+LOCK_RETRY_BACKOFF_SECONDS = _env_float("LOCK_RETRY_BACKOFF_SECONDS", 5.0)
+
+
+def _pid_alive(pid) -> bool:
+    """True quando existe processo com esse pid (PermissionError tambem significa vivo)."""
+    try:
+        pid = int(pid)
+    except (TypeError, ValueError):
+        return False
+    if pid <= 0:
+        return False
+    try:
+        os.kill(pid, 0)
+    except ProcessLookupError:
+        return False
+    except PermissionError:
+        return True
+    except OSError:
+        return False
+    return True
+
+
+def _lease_owner_info(db, session_id: str) -> Optional[Dict[str, Any]]:
+    """Info do dono atual do lease (pid/heartbeat/acquired_at) ou None se indisponivel."""
+    getter = getattr(db, "get_session_turn_lease_info", None)
+    if not callable(getter):
+        return None
+    try:
+        info = getter(session_id)
+    except Exception:
+        return None
+    return dict(info) if isinstance(info, dict) else None
+
+
+def _owner_progress_age_seconds(db, session_id: str, now: Optional[float] = None) -> Optional[float]:
+    """Segundos desde o ultimo progresso do dono. Prefere heartbeat; leases antigos sem o
+    campo caem no acquired_at/mtime (compatibilidade com leases pre-heartbeat)."""
+    info = _lease_owner_info(db, session_id)
+    if not info:
+        return None
+    now = time.time() if now is None else now
+    for key in ("heartbeat", "acquired_at", "mtime"):
+        value = info.get(key)
+        if value is None:
+            continue
+        try:
+            return max(0.0, now - float(value))
+        except (TypeError, ValueError):
+            continue
+    return None
+
+
+def _owner_is_stale(db, session_id: str) -> bool:
+    """Dono morto (pid sumiu) OU zumbi (sem progresso ha > LOCK_STEAL_MIN segundos).
+    Fail-closed: dono vivo com atividade recente NUNCA e considerado stale."""
+    info = _lease_owner_info(db, session_id)
+    if not info:
+        return False
+    pid = info.get("pid")
+    if pid is not None and not _pid_alive(pid):
+        return True
+    age = _owner_progress_age_seconds(db, session_id)
+    if age is None:
+        return False
+    return age > LOCK_STEAL_MIN_SECONDS
+
+
+def _release_stale_lease(db, session_id: str) -> bool:
+    """Libera o lease stale pelo caminho de release que o modulo ja tem."""
+    info = _lease_owner_info(db, session_id)
+    holder = info.get("holder") if info else None
