+        return False
+
+
+def _stamp_lease_heartbeat(db, session_id: str, holder: str) -> None:
+    """Registra progresso do dono para decisoes futuras de takeover; best-effort."""
+    stamper = getattr(db, "stamp_session_turn_lease_heartbeat", None)
