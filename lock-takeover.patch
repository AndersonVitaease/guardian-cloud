+        if _try_acquire_now(db, session_id, holder):
+            _stamp_lease_heartbeat(db, session_id, holder)
+            logger.info("Session turn lease takeover succeeded (stale owner): %s", session_id)
+            return True
+        return False
+
+    if _stale_takeover():
+        return True
